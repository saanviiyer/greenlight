# Anthropic API key for AI request triage and natural-language availability parsing.
# When unset, the app runs in MOCK MODE (deterministic offline output). No key required to run.
ANTHROPIC_API_KEY=

# Owner passphrase that protects the dashboard and all owner-only API routes.
# When unset, the dashboard is OPEN (development mode). Set this before deploying.
OWNER_KEY=

# Port the Node server listens on (defaults to 8787).
PORT=8787
