{
  "name": "greenlight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A smarter Calendly where visitors request a time slot and the owner approves it before it is confirmed, with AI request triage and natural-language availability.",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "TMPDIR=$PWD/.tmp vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
